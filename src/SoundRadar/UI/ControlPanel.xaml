<Window x:Class="SoundRadar.UI.ControlPanel" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundRadar" Width="450" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Swatch + name for the color picker. -->
        <DataTemplate x:Key="ColorItem">
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="72" Height="14" RadiusX="2" RadiusY="2" Fill="{Binding Swatch}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="16,14,16,14">

        <!-- Header: profile + power -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ProfileCombo" SelectionChanged="OnProfileChanged" />
            <ToggleButton x:Name="PowerToggle" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource PowerToggle}"
                          Content="On" Click="OnPowerClick" ToolTip="Show or hide the bars" />
        </Grid>

        <!-- Audio source -->
        <GroupBox Header="Audio source">
            <StackPanel>
                <ComboBox x:Name="SourceCombo" SelectionChanged="OnSourceChanged" />
                <Grid x:Name="AppRow" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="AppCombo" IsEditable="True" ToolTip="The game's .exe name - pick it while the game is making sound"
                              DropDownClosed="OnAppCommitted" LostKeyboardFocus="OnAppCommitted" KeyDown="OnAppKeyDown" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Refresh" Click="OnRefreshApps"
                            ToolTip="List apps that currently have audio open" />
                </Grid>
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource OkFg}" />
                <TextBlock x:Name="MonoText" Margin="0,4,0,0" Style="{StaticResource Hint}" />
            </StackPanel>
        </GroupBox>

        <!-- Response -->
        <GroupBox Header="Response">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sensitivity" />
                    <Slider x:Name="SensitivitySlider" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="OnSensitivityChanged" />
                    <TextBlock x:Name="SensitivityValue" Grid.Column="2" Style="{StaticResource Value}" />
                </Grid>
                <CheckBox x:Name="AutoSensitivityCheck" Margin="92,4,0,4" Content="Auto sensitivity" Click="OnAutoSensitivityClick" />
                <CheckBox x:Name="QuietBoostCheck" Content="Boost quiet sounds (decibel scale)" Click="OnQuietBoostClick"
                          ToolTip="Footsteps and other quiet sounds still move the bars next to loud ones." />
                <CheckBox x:Name="RadarCheck" Content="Radar - only light the louder side, by how much louder" Click="OnRadarClick" />
            </StackPanel>
        </GroupBox>

        <!-- Look (per profile) -->
        <GroupBox Header="Look">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Color" />
                <Grid Grid.Column="1" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="&#x25C0;" Padding="8,4" FontSize="10" Click="OnPrevColor" ToolTip="Previous color" />
                    <ComboBox x:Name="ColorCombo" Grid.Column="1" Margin="6,0" ItemTemplate="{StaticResource ColorItem}"
                              SelectionChanged="OnColorChanged" />
                    <Button Grid.Column="2" Content="&#x25B6;" Padding="8,4" FontSize="10" Click="OnNextColor" ToolTip="Next color" />
                </Grid>

                <TextBlock Grid.Row="1" Text="Mode" Margin="0,8,0,0" />
                <ComboBox x:Name="ModeCombo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" SelectionChanged="OnModeChanged" />

                <TextBlock Grid.Row="2" Text="Segments" Margin="0,8,0,0" />
                <Slider x:Name="SegmentsSlider" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Minimum="0" Maximum="60"
                        ValueChanged="OnSegmentsChanged" ToolTip="0 = one smooth bar; otherwise an LED-strip look" />
                <TextBlock x:Name="SegmentsValue" Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" Style="{StaticResource Value}" />

                <TextBlock Grid.Row="3" Text="Brightness" Margin="0,8,0,0" />
                <Slider x:Name="BrightnessSlider" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Minimum="5" Maximum="100"
                        ValueChanged="OnBrightnessChanged" />
                <TextBlock x:Name="BrightnessValue" Grid.Row="3" Grid.Column="2" Margin="0,8,0,0" Style="{StaticResource Value}" />

                <TextBlock Grid.Row="4" Text="Background" Margin="0,8,0,0" />
                <Slider x:Name="BackgroundSlider" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Minimum="0" Maximum="100"
                        ValueChanged="OnBackgroundChanged" ToolTip="Dark backing behind each bar, so they stay visible on bright screens." />
                <TextBlock x:Name="BackgroundValue" Grid.Row="4" Grid.Column="2" Margin="0,8,0,0" Style="{StaticResource Value}" />
            </Grid>
        </GroupBox>

        <!-- Placement (all profiles) -->
        <GroupBox Header="Placement (all profiles)">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Monitor" />
                <ComboBox x:Name="MonitorCombo" Grid.Column="1" Grid.ColumnSpan="2" SelectionChanged="OnMonitorChanged" />

                <TextBlock Grid.Row="1" Text="Width" Margin="0,8,0,0" />
                <Slider x:Name="WidthSlider" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Minimum="2" Maximum="80" ValueChanged="OnWidthChanged" />
                <TextBlock x:Name="WidthValue" Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" Style="{StaticResource Value}" />

                <TextBlock Grid.Row="2" Text="Length" Margin="0,8,0,0" />
                <Slider x:Name="LengthSlider" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Minimum="10" Maximum="100" ValueChanged="OnLengthChanged" />
                <TextBlock x:Name="LengthValue" Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" Style="{StaticResource Value}" />

                <TextBlock Grid.Row="3" Text="Edge gap" Margin="0,8,0,0" />
                <Slider x:Name="MarginSlider" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Minimum="0" Maximum="300" ValueChanged="OnMarginChanged" />
                <TextBlock x:Name="MarginValue" Grid.Row="3" Grid.Column="2" Margin="0,8,0,0" Style="{StaticResource Value}" />
            </Grid>
        </GroupBox>

        <!-- Footer -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Hotkeys..." Click="OnHotkeys" />
            <Button Grid.Column="1" Content="Restart audio" Margin="8,0,0,0" Click="OnRestartAudio" ToolTip="Reconnect to the audio source" />
            <CheckBox x:Name="AutostartCheck" Grid.Column="2" HorizontalAlignment="Right" Content="Start with Windows"
                      Click="OnAutostartClick" ToolTip="Start in the tray when you sign in" />
        </Grid>
        <TextBlock Margin="0,8,0,0" Style="{StaticResource Hint}"
                   Text="Overlays show over borderless / windowed games, not exclusive fullscreen." />
    </StackPanel>
</Window>
